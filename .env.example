# Copia questo file in .env e personalizza i valori.
# .env NON va committato su git (contiene la tua posizione) — è già in .gitignore.

# Coordinate del centro di ricerca (default: Via Giulio Antamoro, Roma)
CENTER_LAT=41.9593
CENTER_LON=12.5449

# Raggio di ricerca in km
RADIUS_KM=3

# Ogni quanti secondi ricaricare i dati dalla fonte MIMIT (default: 6 ore)
CACHE_TTL_SECONDS=21600

# true = nasconde dalla card i distributori senza alcun prezzo comunicato
HIDE_EMPTY_STATIONS=true
